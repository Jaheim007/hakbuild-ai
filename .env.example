# HakBuild AI - configuration locale (copier vers .env, jamais committer .env)

# Base SQLite de la plateforme
DATABASE_URL=sqlite:///data/hakbuild.db
DATA_DIR=data

# Dashboard
HOST=127.0.0.1
PORT=8080

# dry-run : planifie le build sans appeler EAS
# execute : lance reellement npm install puis EAS build (compte Expo requis)
BUILD_MODE=dry-run

# Secrets (vides par defaut, a remplir dans .env)
OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=
GITHUB_TOKEN=
CONVEX_DEPLOY_KEY=
EAS_TOKEN=
CLERK_SECRET_KEY=
